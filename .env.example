# Configuración de Entorno — Lista Plazo Fijo v2.0
PORT=3001
NODE_ENV=development

# Motor de Base de Datos: 'sqlite' (por defecto) o 'postgres'
DB_TYPE=sqlite
DB_PATH=plazo_fijo.db

# Configuración opcional para PostgreSQL
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/plazofijodb
